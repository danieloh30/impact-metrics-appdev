# The OpenShift extension uploads only target/quarkus-app into the binary Docker build.
# Instructions and the entrypoint are packaged resources, never local runtime state.
FROM eclipse-temurin:25-jre-noble

USER 0
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY lib/ /deployments/lib/
COPY *.jar /deployments/
COPY app/ /deployments/app/
COPY quarkus/ /deployments/quarkus/

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/metrics-browsers PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN java -cp '/deployments/lib/main/*' com.microsoft.playwright.CLI install --with-deps chromium \
    && mkdir -p /opt/metrics-instructions /data/metrics \
    && for archive in /deployments/app/*.jar; do \
        unzip -p "$archive" metrics-container/start-container.sh > /opt/metrics-start.sh; \
        unzip -p "$archive" metrics-instructions/RUN.md > /opt/metrics-instructions/RUN.md; \
        unzip -p "$archive" metrics-instructions/AGENTS.md > /opt/metrics-instructions/AGENTS.md; \
       done \
    && test -s /opt/metrics-start.sh && test -s /opt/metrics-instructions/RUN.md \
    && test -s /opt/metrics-instructions/AGENTS.md \
    && browser="$(find /opt/metrics-browsers -type f -path '*/chrome-linux*/chrome' -print -quit)" \
    && test -n "$browser" && ln -s "$browser" /usr/local/bin/metrics-chromium \
    && chmod 755 /opt/metrics-start.sh \
    && chgrp -R 0 /deployments /opt/metrics-browsers /opt/metrics-instructions /data \
    && chmod -R g=u /deployments /opt/metrics-browsers /opt/metrics-instructions /data \
    && apt-get purge -y xvfb \
    && rm -rf /var/lib/apt/lists/*

ENV QUARKUS_PROFILE=openshift \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    METRICS_RUNTIME_ROOT=/data/metrics/runtimes \
    HOME=/data/metrics/.home

WORKDIR /deployments
EXPOSE 8097
USER 1001:0
ENTRYPOINT ["/opt/metrics-start.sh"]
